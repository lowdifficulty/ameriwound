{
  "functions": {
    "app/api/transcribe/route.ts": {
      "maxDuration": 120
    },
    "app/api/generate-notes/route.ts": {
      "maxDuration": 120
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
